// DRISHTI-G data model — Layer 0, a NYC 311 replica.
//
// This schema describes a municipal service-request system as New York City
// actually runs one, and nothing else. There are no ranks, no sectors, no
// escalations, no officers and no risk scores in this file, and their absence is
// the point rather than an omission: Layer 0 is the control condition that every
// later layer is measured against, and a baseline that has quietly borrowed one
// of our own concepts cannot measure anything (N5).
//
// The NOIDA Authority model this replaces — zones, work circles, sectors, an
// eight-rank chain of command, crews and contractors — is not deleted. It lives
// on `main` and on `archive/noida-model`, both of which stay recoverable and
// citable. Commenting it out here instead would have left a half-migrated domain
// model, which is where the next six weeks of bugs come from.
//
// What is faithfully NYC's, and what is ours, is recorded per model below. Every
// value that NYC does not publish and we derived instead carries its provenance
// in the schema rather than in a document nobody opens.
//
// Postgres is the system of record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — every value here was read off the corpus, not invented
// ---------------------------------------------------------------------------

/// What someone may do. Layer 0 has exactly three kinds of user and two of them
/// sign in; the public needs no account at all, because NYC lets anyone look up
/// any service request by its number and so do we.
///
/// There is deliberately no OFFICER, SUPERVISOR or ADMIN. Named individual
/// ownership is a Layer 1 addition, and NYC records no case-worker identity to
/// replicate (F-12). An agent here has agency-level accountability only, which
/// is exactly how 311 works.
enum Role {
  CITIZEN /// files requests, sees their own
  AGENT /// works an agency's queue; accountable as the agency, not as a person
}

/// The status values NYC publishes, kept as they are.
///
/// All seven appear in the Brooklyn slice: Closed 349,115, Pending 3,312,
/// Assigned 860, Open 788, Started 583, Unspecified 386, In Progress 386. The
/// build plan expected six and listed no STARTED; DSNY uses it, so it is here.
///
/// The mapping from NYC's strings to this enum is therefore the identity, and
/// that is the honest outcome: collapsing STARTED into IN_PROGRESS because two
/// values felt redundant would be editing the source record to fit a tidier
/// model, and Gate 2 asks whether our copy matches the source.
enum RequestStatus {
  OPEN
  ASSIGNED
  STARTED
  IN_PROGRESS
  PENDING
  CLOSED
  UNSPECIFIED
}

/// How the request reached 311. Counts in the slice: ONLINE 136,031,
/// PHONE 99,607, UNKNOWN 78,454, MOBILE 41,324, OTHER 14.
///
/// UNKNOWN is a value NYC itself publishes, not our null. It is worth surfacing
/// because 311 is a telephone service first and the channel mix is one of the
/// few things this data says about how citizens actually reach a city.
enum Channel {
  PHONE
  ONLINE
  MOBILE
  OTHER
  UNKNOWN
}

/// Where a request type's service level came from.
///
/// This exists because NYC publishes **no `due_date` at all** for any of our six
/// complaint types — zero of 355,430, verified in V1 against the dataset
/// metadata rather than inferred from a null count. Every SLA in this system is
/// therefore derived, and the enum makes that impossible to forget: a
/// `RequestType` cannot be written without saying where its promise came from.
///
/// The previous system carried 17 assumed constants with no such marker, and
/// that is the single thing about it a reviewer could dismiss outright.
enum SlaSource {
  PUBLISHED /// NYC published a due_date for this type. Currently used by nothing.
  DERIVED_P75 /// citywide 75th percentile of observed time-to-close, from the corpus
}

// ---------------------------------------------------------------------------
// Geography — two levels, because NYC's geography does not nest any deeper
// ---------------------------------------------------------------------------

/// The org unit tree: borough at depth 0, community board at depth 1.
///
/// Depth 2 and not 3, and that is a property of New York rather than a
/// simplification. Council districts and police precincts cross community board
/// boundaries, so they cannot be nodes in a tree that already has boards in it
/// (F-13). They are carried as flat attributes on the request instead, where
/// they can overlap freely.
///
/// The tree itself is unchanged from the previous system — materialised path,
/// denormalised depth, maintained `isLeaf` — because it was written to take a
/// configurable depth and this is the first time that has been exercised.
model OrgUnit {
  id   Int    @id @default(autoincrement())
  /// Stable natural key. "BK" for the borough, "BK-04" for a community board.
  code String @unique
  name String

  parentId Int?
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children OrgUnit[] @relation("OrgUnitTree")

  /// 0 for the borough. Denormalised so a layer can be queried without
  /// recursing, and validated against `parent.depth + 1` on every write.
  depth Int

  /// Materialised path of ancestor ids, e.g. "/1/4/". Subtree rollups are
  /// `path STARTS WITH '/1/'`, which keeps a borough dashboard one query.
  path String

  /// What this layer is called here — "Borough", "Community Board". A label and
  /// never an enum, so renaming a layer costs nothing.
  kindLabel String

  /// True when the unit has no children. Maintained on write.
  isLeaf Boolean @default(true)

  /// Centroid of the requests actually filed here, computed at seed time from
  /// the corpus. NYC publishes no board centroid, and this is a measurement of
  /// where the work is rather than a guess at where the middle is.
  centroidLat Float?
  centroidLon Float?

  isActive Boolean @default(true)

  requests ServiceRequest[]
  users    User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([depth])
  @@index([path])
  @@map("org_units")
}

/// A city agency. DOT, DSNY, DEP.
///
/// Replaces `Department`. Three and not the four the build plan listed: DPR
/// would have carried the public-toilet category, and NYC has no analogue for
/// it, so seeding a DPR row with nothing in it would be inventing an
/// organisation to match a table (F-16).
model Agency {
  id   Int    @id @default(autoincrement())
  /// NYC's own acronym, exactly as the `agency` column publishes it.
  code String @unique
  /// NYC's own long form, from `agency_name`.
  name String

  requestTypes RequestType[]
  requests     ServiceRequest[]
  users        User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agencies")
}

// ---------------------------------------------------------------------------
// Taxonomy — two levels, which is a real migration and not a reseed
// ---------------------------------------------------------------------------

/// Level 1 of the taxonomy: NYC's `complaint_type`.
///
/// The previous system had a single flat category list. NYC has two levels, and
/// the second one carries most of the information — "Street Light Condition"
/// says which agency, "Street Light Out" says what the crew will find. Flattening
/// them into one list would have thrown away the level an intake wizard actually
/// needs.
model RequestType {
  id       Int    @id @default(autoincrement())
  /// Slug of the NYC name, e.g. "street-light-condition".
  code     String @unique
  /// NYC's `complaint_type`, verbatim.
  name     String @unique
  agencyId Int

  /// The service level, in hours. Derived — see `slaSource`, and see the note
  /// on that enum for why nothing here is published.
  slaHours  Float
  slaSource SlaSource @default(DERIVED_P75)
  /// The sentence that has to travel with any breach figure computed from this
  /// SLA. Stored rather than templated so a caption can never quietly drop it.
  slaNote   String

  agency      Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  descriptors RequestDescriptor[]
  requests    ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@map("request_types")
}

/// Level 2 of the taxonomy: NYC's `descriptor`. 130 of them across six types.
model RequestDescriptor {
  id            Int    @id @default(autoincrement())
  name          String
  requestTypeId Int

  requestType RequestType      @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  requests    ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A descriptor name is only unique inside its type — "Other" appears under
  /// several — so the natural key is the pair.
  @@unique([requestTypeId, name])
  @@index([requestTypeId])
  @@map("request_descriptors")
}

// ---------------------------------------------------------------------------
// The core record
// ---------------------------------------------------------------------------

/// One service request. Replaces `Complaint`.
///
/// Roughly 350,000 of these are imported from NYC Open Data and a handful are
/// filed through our own intake. `isImported` is what separates them, and it is
/// load-bearing in three places at once — the scheduler must not enqueue work
/// for historical rows (I6), the audit chain must never claim our system acted
/// on one (I5), and the UI has to be able to say which is which.
model ServiceRequest {
  id Int @id @default(autoincrement())

  /// The number a citizen quotes. `NYC-59489502` for imported requests, whose
  /// suffix is NYC's `unique_key`; `DG-2026-000042` for ones filed here. The
  /// prefix is deliberately visible: a citizen looking up a request should be
  /// able to tell a historical record from one this system created.
  srNumber String @unique

  /// Set when a signed-in citizen files. Null for imported requests and for
  /// anonymous filings — NYC publishes no reporter identity, and inventing one
  /// would be fabricating a person.
  citizenId Int?

  typeId       Int
  descriptorId Int?
  agencyId     Int
  /// The community board the incident falls in. Null for the 1.5% of imported
  /// requests NYC could not place; those are kept, because dropping them would
  /// silently change the borough totals, but they are attributed to no unit.
  orgUnitId    Int?

  status  RequestStatus @default(OPEN)
  channel Channel       @default(UNKNOWN)

  /// NYC's `created_date` for imported rows. Real historical timestamps, never
  /// shifted: garbage complaints genuinely spike in summer and streetlight
  /// complaints in winter, and time-shifting the corpus to make it look recent
  /// would destroy the seasonality the risk signals are built on (I4).
  createdAt DateTime
  closedAt  DateTime?

  /// Intake plus the type's derived SLA. Stored rather than computed on read so
  /// a queue can sort by it, but *overdue* is never stored — it is
  /// `slaDueAt < referenceDate`, evaluated against the system reference date and
  /// not against wall-clock time. That distinction is F-04, and on a corpus that
  /// ends in 2025 the wall-clock version marks every request overdue.
  slaDueAt DateTime?

  latitude  Float?
  longitude Float?
  address   String?
  zip       String?

  /// Geographies that overlap community boards and so cannot be tree nodes.
  councilDistrict String?
  policePrecinct  String?

  /// NYC's `resolution_description`: the agency's own account of what it did.
  /// Useful text, and not citizen text — NYC publishes none of that (F-14).
  resolutionNote String?

  /// True for the ~350,000 rows that came from NYC Open Data. See the model
  /// comment; nothing about this flag is cosmetic.
  isImported Boolean @default(false)

  citizen    User?              @relation("RequestCitizen", fields: [citizenId], references: [id], onDelete: SetNull)
  type       RequestType        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  descriptor RequestDescriptor? @relation(fields: [descriptorId], references: [id], onDelete: SetNull)
  agency     Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  orgUnit    OrgUnit?           @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  history RequestStatusHistory[]

  updatedAt DateTime @updatedAt

  /// The agency queue is the one screen that has to stay fast at 350k rows, and
  /// it filters on agency and status and sorts by age. This index is that query.
  @@index([agencyId, status, createdAt])
  @@index([orgUnitId, status])
  @@index([typeId, status])
  @@index([citizenId])
  @@index([status, slaDueAt])
  @@index([createdAt])
  @@map("service_requests")
}

/// Every status transition this system observed.
///
/// Imported requests get **one** row: their arrival in the state NYC last
/// published them in. NYC does not publish a status history, so writing an
/// invented "assigned then in progress then closed" sequence would be
/// manufacturing evidence — and this table feeds the process-mining event log,
/// where a fabricated trace would propagate straight into a paper (I5).
model RequestStatusHistory {
  id         Int            @id @default(autoincrement())
  requestId  Int
  /// Null on the first row: nothing preceded it.
  fromStatus RequestStatus?
  toStatus   RequestStatus
  at         DateTime
  /// Null when the transition was not made by a user of this system, which is
  /// every imported row.
  actorId    Int?
  note       String?

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([requestId, at])
  @@index([actorId])
  @@map("request_status_history")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?

  role Role @default(CITIZEN)

  /// Which agency an agent works for. Null for citizens.
  agencyId  Int?
  /// A citizen's home board, used to pre-fill intake. Not an authority scope:
  /// scoping work to a unit is a Layer 1 concept.
  orgUnitId Int?

  /// True for any account this project created to stand in for a role NYC does
  /// not record. Every Layer 0 agent is synthetic, because NYC publishes no
  /// case-worker identity at all (F-12), and the UI must say so wherever such an
  /// account is shown. Never present a synthetic account as a real person.
  isSynthetic Boolean @default(false)

  isActive Boolean @default(true)

  agency  Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  requests    ServiceRequest[]       @relation("RequestCitizen")
  transitions RequestStatusHistory[]
  auditEvents AuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([agencyId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only hash chain over everything this system does.
///
/// Carried across the rebuild unchanged, including both hard-won constraints
/// below, because it is one of the three things that are actually our
/// contribution rather than NYC's.
///
/// What changes is what goes into it. An imported request receives exactly one
/// entry — that it was imported — and never an invented action. The chain's
/// entire value is that it is a record of *our* actions, and an examiner who
/// finds a fabricated "inspected" event in it will not believe anything else in
/// the system either (I5).
model AuditEvent {
  id Int @id @default(autoincrement())

  actorId    Int?
  actorLabel String?

  action     String
  entityType String
  entityId   String

  payload Json
  /// api | import | system
  source  String @default("api")

  prevHash String?
  hash     String

  /// `Restrict`, not `SetNull`, and the distinction is the whole point of this
  /// table. `actorId` is one of the fields the hash covers, so a cascade that
  /// nulled it would rewrite the hashed content of every entry a deleted user
  /// ever produced — and every one of them would then fail verification,
  /// reported as "edited after the fact", which is exactly what the schema would
  /// have done. 273 entries were destroyed this way before it was changed.
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  /// Every row in a valid chain points at a different predecessor. Two rows
  /// sharing a `prevHash` means the chain forked — two writers appended to the
  /// same head — and this turns silent corruption into a failed write. One
  /// simulated run produced 410 duplicated hashes and 485 broken links before
  /// the append took an advisory lock; this constraint is what catches anything
  /// that appends without one.
  @@unique([prevHash])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}
