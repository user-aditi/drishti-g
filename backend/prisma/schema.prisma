// DRISHTI-G data model — Layer 0, a NYC 311 replica, and Layer 1 on top of it.
//
// This schema describes a municipal service-request system as New York City
// actually runs one, and nothing else. There are no ranks, no sectors, no
// escalations, no officers and no risk scores in this file, and their absence is
// the point rather than an omission: Layer 0 is the control condition that every
// later layer is measured against, and a baseline that has quietly borrowed one
// of our own concepts cannot measure anything (N5).
//
// The NOIDA Authority model this replaces — zones, work circles, sectors, an
// eight-rank chain of command, crews and contractors — is not deleted. It lives
// on `main` and on `archive/noida-model`, both of which stay recoverable and
// citable. Commenting it out here instead would have left a half-migrated domain
// model, which is where the next six weeks of bugs come from.
//
// What is faithfully NYC's, and what is ours, is recorded per model below. Every
// value that NYC does not publish and we derived instead carries its provenance
// in the schema rather than in a document nobody opens.
//
// Layer 1 — named officer identity — is the first thing that is ours. Its models
// live in their own section at the end of this file, and the Layer 0 routes do
// not reference them: the baseline has to stay measurable without them (N5).
//
// Layer 2 — escalation — follows the same rule one rung up: Layer 1 does not
// reference it, and Layer 0 references neither.
//
// Postgres is the system of record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — every value here was read off the corpus, not invented
// ---------------------------------------------------------------------------

/// What someone may do. Layer 0 has exactly three kinds of user and two of them
/// sign in; the public needs no account at all, because NYC lets anyone look up
/// any service request by its number and so do we.
///
/// CITIZEN and AGENT are Layer 0 and exist in NYC's model of 311: an agent has
/// agency-level accountability only, which is exactly how 311 works.
///
/// OFFICER and SUPERVISOR are Layer 1 and do not. NYC records no case-worker
/// identity at all (F-12), so every account holding one of these roles is
/// synthetic and must be marked so wherever it is shown. SUPERVISOR arrives here
/// rather than with escalation in Layer 2, because assigning a request to a
/// named person needs someone entitled to do the assigning.
enum Role {
  CITIZEN /// files requests, sees their own
  AGENT /// works an agency's queue; accountable as the agency, not as a person
  OFFICER /// Layer 1: the named person accountable for specific requests
  SUPERVISOR /// Layer 1: assigns and reassigns officers within an agency
  COMMISSIONER /// Layer 2: heads an agency in the borough; the top of the escalation ladder
  ADMIN /// Layer 3: reads the risk register, the routing report and the audit chain
}

/// The status values NYC publishes, kept as they are.
///
/// All seven appear in the Brooklyn slice: Closed 349,115, Pending 3,312,
/// Assigned 860, Open 788, Started 583, Unspecified 386, In Progress 386. The
/// build plan expected six and listed no STARTED; DSNY uses it, so it is here.
///
/// The mapping from NYC's strings to this enum is therefore the identity, and
/// that is the honest outcome: collapsing STARTED into IN_PROGRESS because two
/// values felt redundant would be editing the source record to fit a tidier
/// model, and Gate 2 asks whether our copy matches the source.
enum RequestStatus {
  OPEN
  ASSIGNED
  STARTED
  IN_PROGRESS
  PENDING
  CLOSED
  UNSPECIFIED
}

/// How the request reached 311. Counts in the slice: ONLINE 136,031,
/// PHONE 99,607, UNKNOWN 78,454, MOBILE 41,324, OTHER 14.
///
/// UNKNOWN is a value NYC itself publishes, not our null. It is worth surfacing
/// because 311 is a telephone service first and the channel mix is one of the
/// few things this data says about how citizens actually reach a city.
enum Channel {
  PHONE
  ONLINE
  MOBILE
  OTHER
  UNKNOWN
}

/// Where a request type's service level came from.
///
/// This exists because NYC publishes **no `due_date` at all** for any of our six
/// complaint types — zero of 355,430, verified in V1 against the dataset
/// metadata rather than inferred from a null count. Every SLA in this system is
/// therefore derived, and the enum makes that impossible to forget: a
/// `RequestType` cannot be written without saying where its promise came from.
///
/// The previous system carried 17 assumed constants with no such marker, and
/// that is the single thing about it a reviewer could dismiss outright.
enum SlaSource {
  PUBLISHED /// NYC published a due_date for this type. Currently used by nothing.
  DERIVED_P75 /// citywide 75th percentile of observed time-to-close, from the corpus
}

// ---------------------------------------------------------------------------
// Geography — two levels, because NYC's geography does not nest any deeper
// ---------------------------------------------------------------------------

/// The org unit tree: borough at depth 0, community board at depth 1.
///
/// Depth 2 and not 3, and that is a property of New York rather than a
/// simplification. Council districts and police precincts cross community board
/// boundaries, so they cannot be nodes in a tree that already has boards in it
/// (F-13). They are carried as flat attributes on the request instead, where
/// they can overlap freely.
///
/// The tree itself is unchanged from the previous system — materialised path,
/// denormalised depth, maintained `isLeaf` — because it was written to take a
/// configurable depth and this is the first time that has been exercised.
model OrgUnit {
  id   Int    @id @default(autoincrement())
  /// Stable natural key. "BK" for the borough, "BK-04" for a community board.
  code String @unique
  name String

  parentId Int?
  parent   OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children OrgUnit[] @relation("OrgUnitTree")

  /// 0 for the borough. Denormalised so a layer can be queried without
  /// recursing, and validated against `parent.depth + 1` on every write.
  depth Int

  /// Materialised path of ancestor ids, e.g. "/1/4/". Subtree rollups are
  /// `path STARTS WITH '/1/'`, which keeps a borough dashboard one query.
  path String

  /// What this layer is called here — "Borough", "Community Board". A label and
  /// never an enum, so renaming a layer costs nothing.
  kindLabel String

  /// True when the unit has no children. Maintained on write.
  isLeaf Boolean @default(true)

  /// Centroid of the requests actually filed here, computed at seed time from
  /// the corpus. NYC publishes no board centroid, and this is a measurement of
  /// where the work is rather than a guess at where the middle is.
  centroidLat Float?
  centroidLon Float?

  isActive Boolean @default(true)

  requests ServiceRequest[]
  users    User[]
  postings Posting[]

  // Layer 3
  riskScores RiskScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([depth])
  @@index([path])
  @@map("org_units")
}

/// A city agency. DOT, DSNY, DEP.
///
/// Replaces `Department`. Three and not the four the build plan listed: DPR
/// would have carried the public-toilet category, and NYC has no analogue for
/// it, so seeding a DPR row with nothing in it would be inventing an
/// organisation to match a table (F-16).
model Agency {
  id   Int    @id @default(autoincrement())
  /// NYC's own acronym, exactly as the `agency` column publishes it.
  code String @unique
  /// NYC's own long form, from `agency_name`.
  name String

  requestTypes RequestType[]
  requests     ServiceRequest[]
  users        User[]
  postings     Posting[]

  // Layer 3
  riskScores   RiskScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agencies")
}

// ---------------------------------------------------------------------------
// Taxonomy — two levels, which is a real migration and not a reseed
// ---------------------------------------------------------------------------

/// Level 1 of the taxonomy: NYC's `complaint_type`.
///
/// The previous system had a single flat category list. NYC has two levels, and
/// the second one carries most of the information — "Street Light Condition"
/// says which agency, "Street Light Out" says what the crew will find. Flattening
/// them into one list would have thrown away the level an intake wizard actually
/// needs.
model RequestType {
  id       Int    @id @default(autoincrement())
  /// Slug of the NYC name, e.g. "street-light-condition".
  code     String @unique
  /// NYC's `complaint_type`, verbatim.
  name     String @unique
  agencyId Int

  /// The service level, in hours. Derived — see `slaSource`, and see the note
  /// on that enum for why nothing here is published.
  slaHours  Float
  slaSource SlaSource @default(DERIVED_P75)
  /// The sentence that has to travel with any breach figure computed from this
  /// SLA. Stored rather than templated so a caption can never quietly drop it.
  slaNote   String

  agency      Agency              @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  descriptors RequestDescriptor[]
  requests    ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
  @@map("request_types")
}

/// Level 2 of the taxonomy: NYC's `descriptor`. 130 of them across six types.
model RequestDescriptor {
  id            Int    @id @default(autoincrement())
  name          String
  requestTypeId Int

  requestType RequestType      @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  requests    ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A descriptor name is only unique inside its type — "Other" appears under
  /// several — so the natural key is the pair.
  @@unique([requestTypeId, name])
  @@index([requestTypeId])
  @@map("request_descriptors")
}

// ---------------------------------------------------------------------------
// The core record
// ---------------------------------------------------------------------------

/// One service request. Replaces `Complaint`.
///
/// Roughly 350,000 of these are imported from NYC Open Data and a handful are
/// filed through our own intake. `isImported` is what separates them, and it is
/// load-bearing in three places at once — the scheduler must not enqueue work
/// for historical rows (I6), the audit chain must never claim our system acted
/// on one (I5), and the UI has to be able to say which is which.
model ServiceRequest {
  id Int @id @default(autoincrement())

  /// The number a citizen quotes. `NYC-59489502` for imported requests, whose
  /// suffix is NYC's `unique_key`; `DG-2026-000042` for ones filed here. The
  /// prefix is deliberately visible: a citizen looking up a request should be
  /// able to tell a historical record from one this system created.
  srNumber String @unique

  /// Set when a signed-in citizen files. Null for imported requests and for
  /// anonymous filings — NYC publishes no reporter identity, and inventing one
  /// would be fabricating a person.
  citizenId Int?

  typeId       Int
  descriptorId Int?
  agencyId     Int
  /// The community board the incident falls in. Null for the 1.5% of imported
  /// requests NYC could not place; those are kept, because dropping them would
  /// silently change the borough totals, but they are attributed to no unit.
  orgUnitId    Int?

  status  RequestStatus @default(OPEN)
  channel Channel       @default(UNKNOWN)

  /// NYC's `created_date` for imported rows. Real historical timestamps, never
  /// shifted: garbage complaints genuinely spike in summer and streetlight
  /// complaints in winter, and time-shifting the corpus to make it look recent
  /// would destroy the seasonality the risk signals are built on (I4).
  createdAt DateTime
  closedAt  DateTime?

  /// Intake plus the type's derived SLA. Stored rather than computed on read so
  /// a queue can sort by it, but *overdue* is never stored — it is
  /// `slaDueAt < referenceDate`, evaluated against the system reference date and
  /// not against wall-clock time. That distinction is F-04, and on a corpus that
  /// ends in 2025 the wall-clock version marks every request overdue.
  slaDueAt DateTime?

  latitude  Float?
  longitude Float?
  address   String?
  zip       String?

  /// Geographies that overlap community boards and so cannot be tree nodes.
  councilDistrict String?
  policePrecinct  String?

  /// NYC's `resolution_description`: the agency's own account of what it did.
  /// Useful text, and not citizen text — NYC publishes none of that (F-14).
  resolutionNote String?

  /// True for the ~350,000 rows that came from NYC Open Data. See the model
  /// comment; nothing about this flag is cosmetic.
  isImported Boolean @default(false)

  /// Layer 1 — ours, not NYC's. The one person accountable for this request
  /// while it is open. Set by the posting rule or a supervisor, never imported:
  /// NYC publishes no owner, and backdating one onto a historical row would be
  /// inventing who worked it. `assignedAt` is when *this system* made the
  /// assignment, in real time, which is why it can be years after `createdAt`.
  assignedOfficerId Int?
  assignedAt        DateTime?

  /// Layer 2 — how far up the ladder this request has gone: 0 with its officer,
  /// 1 with the agency's supervisor, 2 with the borough commissioner. NYC has no
  /// escalation at all (F-12), so every imported row starts at 0 and stays there
  /// unless this system acts on it — its absence in the baseline is the point.
  escalationLevel Int @default(0)

  citizen         User?              @relation("RequestCitizen", fields: [citizenId], references: [id], onDelete: SetNull)
  type            RequestType        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  descriptor      RequestDescriptor? @relation(fields: [descriptorId], references: [id], onDelete: SetNull)
  agency          Agency             @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  orgUnit         OrgUnit?           @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  assignedOfficer User?              @relation("RequestOfficer", fields: [assignedOfficerId], references: [id], onDelete: Restrict)

  history     RequestStatusHistory[]
  photos      RequestPhoto[]
  assignments Assignment[]
  workOrders  WorkOrder[]
  escalations Escalation[]

  updatedAt DateTime @updatedAt

  /// The agency queue is the one screen that has to stay fast at 350k rows, and
  /// it filters on agency and status and sorts by age. This index is that query.
  @@index([agencyId, status, createdAt])
  @@index([orgUnitId, status])
  @@index([typeId, status])
  @@index([citizenId])
  @@index([status, slaDueAt])
  @@index([createdAt])
  /// An officer's desk: their open requests, most urgent first.
  @@index([assignedOfficerId, status, slaDueAt])
  /// The escalation sweep: live, open, past its deadline.
  @@index([isImported, status, slaDueAt])
  @@map("service_requests")
}

/// A photograph of the problem, attached by whoever filed the request.
///
/// NYC's own online form takes attachments, so this is part of the replica, not
/// one of our layers. Not public: a photograph of a street can hold a face or a
/// number plate, so only the person who reported it and the agency see it.
model RequestPhoto {
  id         Int      @id @default(autoincrement())
  requestId  Int
  /// Generated here, never the name the uploader chose.
  storedName String   @unique
  mimeType   String
  bytes      Int
  sha256     String
  width      Int?
  height     Int?
  uploadedAt DateTime @default(now())

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("request_photos")
}

/// Something that happened that a person should hear about, shown in the app.
///
/// In-app only. An academic replica has no business sending email or texts to
/// anyone, and a notification that can only be read here says so by being here.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// A short machine name for what happened, e.g. `request.status_changed`.
  kind      String
  title     String
  body      String
  /// Where to go to act on it, inside the app.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Every status transition this system observed.
///
/// Imported requests get **one** row: their arrival in the state NYC last
/// published them in. NYC does not publish a status history, so writing an
/// invented "assigned then in progress then closed" sequence would be
/// manufacturing evidence — and this table feeds the process-mining event log,
/// where a fabricated trace would propagate straight into a paper (I5).
model RequestStatusHistory {
  id         Int            @id @default(autoincrement())
  requestId  Int
  /// Null on the first row: nothing preceded it.
  fromStatus RequestStatus?
  toStatus   RequestStatus
  at         DateTime
  /// Null when the transition was not made by a user of this system, which is
  /// every imported row.
  actorId    Int?
  note       String?

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([requestId, at])
  @@index([actorId])
  @@map("request_status_history")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  passwordHash String
  name         String
  phone        String?

  role Role @default(CITIZEN)

  /// Which agency an agent works for. Null for citizens.
  agencyId  Int?
  /// A citizen's home board, used to pre-fill intake. Not an authority scope:
  /// scoping work to a unit is a Layer 1 concept.
  orgUnitId Int?

  /// True for any account this project created to stand in for a role NYC does
  /// not record. Every Layer 0 agent is synthetic, because NYC publishes no
  /// case-worker identity at all (F-12), and the UI must say so wherever such an
  /// account is shown. Never present a synthetic account as a real person.
  isSynthetic Boolean @default(false)

  isActive Boolean @default(true)

  /// Sessions are signed tokens with no server-side record, so a password change
  /// cannot revoke them one by one. Instead any token issued before this moment
  /// is refused: changing a password signs every other device out.
  passwordChangedAt DateTime?

  agency  Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  orgUnit OrgUnit? @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  requests      ServiceRequest[]       @relation("RequestCitizen")
  transitions   RequestStatusHistory[]
  auditEvents   AuditEvent[]
  notifications Notification[]

  // Layer 1
  postings            Posting[]
  assignedRequests    ServiceRequest[] @relation("RequestOfficer")
  assignmentsReceived Assignment[]     @relation("AssignmentOfficer")
  assignmentsMade     Assignment[]     @relation("AssignmentBy")
  workOrdersIssued    WorkOrder[]

  // Layer 2
  escalationsRaised   Escalation[]     @relation("EscalationBy")
  escalationsReceived Escalation[]     @relation("EscalationTo")
  escalationsAcknowledged Escalation[] @relation("EscalationAcknowledgedBy")

  // Layer 4
  proofsDecided       WorkProof[]      @relation("ProofOfficer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([agencyId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only hash chain over everything this system does.
///
/// Carried across the rebuild unchanged, including both hard-won constraints
/// below, because it is one of the three things that are actually our
/// contribution rather than NYC's.
///
/// What changes is what goes into it. An imported request receives exactly one
/// entry — that it was imported — and never an invented action. The chain's
/// entire value is that it is a record of *our* actions, and an examiner who
/// finds a fabricated "inspected" event in it will not believe anything else in
/// the system either (I5).
model AuditEvent {
  id Int @id @default(autoincrement())

  actorId    Int?
  actorLabel String?

  action     String
  entityType String
  entityId   String

  payload Json
  /// api | import | system
  source  String @default("api")

  prevHash String?
  hash     String

  /// `Restrict`, not `SetNull`, and the distinction is the whole point of this
  /// table. `actorId` is one of the fields the hash covers, so a cascade that
  /// nulled it would rewrite the hashed content of every entry a deleted user
  /// ever produced — and every one of them would then fail verification,
  /// reported as "edited after the fact", which is exactly what the schema would
  /// have done. 273 entries were destroyed this way before it was changed.
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  /// Every row in a valid chain points at a different predecessor. Two rows
  /// sharing a `prevHash` means the chain forked — two writers appended to the
  /// same head — and this turns silent corruption into a failed write. One
  /// simulated run produced 410 duplicated hashes and 485 broken links before
  /// the append took an advisory lock; this constraint is what catches anything
  /// that appends without one.
  @@unique([prevHash])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_events")
}

// ===========================================================================
// LAYER 1 — officer identity. Ours, not NYC's.
// ===========================================================================
//
// Nothing below this line exists in NYC 311. It is the first layer this project
// adds, and it is measured only by what can be observed honestly: whether every
// open request has exactly one accountable person, and how long this system
// takes to make an assignment. It is *not* measured by any change in resolution
// time, because NYC records no case-worker identity to replay against (F-12),
// and a simulated officer would be exactly the invented behaviour the rebuild
// exists to remove.

/// Where an officer or supervisor sits: one agency, one unit.
///
/// The unit is a community board for an officer who works one, or the borough
/// for a duty officer who catches what no board holds — 180 open requests have
/// no board at all, 170 of them DOT's, and "every open request has exactly one
/// accountable person" has to include them. Rank is deliberately absent: a chain
/// of command is what escalation walks, and that is Layer 2.
model Posting {
  id        Int       @id @default(autoincrement())
  userId    Int
  agencyId  Int
  orgUnitId Int
  startedAt DateTime  @default(now())
  /// Set on transfer. Ended postings keep their history and stop receiving work.
  endedAt   DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, orgUnitId, endedAt])
  @@index([userId, endedAt])
  @@map("postings")
}

/// Who decided an assignment.
enum AssignmentSource {
  POSTING_RULE /// the officer posted to the request's board, chosen by load
  SUPERVISOR /// a supervisor picked the officer by hand
}

/// Every assignment this system made, kept rather than overwritten.
///
/// `ServiceRequest.assignedOfficerId` answers "who holds it now"; this table
/// answers "who held it, from when, and who decided" — which is what assignment
/// latency, one of Layer 1's two honest measures, is computed from.
model Assignment {
  id           Int              @id @default(autoincrement())
  requestId    Int
  officerId    Int
  /// Null when the posting rule assigned it rather than a person.
  assignedById Int?
  source       AssignmentSource
  /// Real time: this is an event in our system, not an observation of NYC's.
  at           DateTime

  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  officer    User           @relation("AssignmentOfficer", fields: [officerId], references: [id], onDelete: Restrict)
  assignedBy User?          @relation("AssignmentBy", fields: [assignedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([requestId, at])
  @@index([officerId, at])
  @@map("assignments")
}

/// A job handed to somebody with no account.
///
/// Field labour has no login here and never will: modelling rotating crews as
/// users with passwords would be a fiction, and the first crew change would
/// break it. So a job is addressed by a short code — printed, sent as a link, or
/// shown as a QR — and the code is the whole credential. It expires, it reveals
/// only what someone standing at the site would already know, and it can do one
/// thing: report the work done.
model WorkOrder {
  id             Int       @id @default(autoincrement())
  requestId      Int
  /// The officer who issued it and answers for the outcome.
  issuedById     Int
  /// e.g. "K7M2-4QX9", from an alphabet with no look-alike characters.
  code           String    @unique
  instructions   String?
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  completedAt    DateTime?
  completionNote String?
  cancelledAt    DateTime?

  request  ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  issuedBy User           @relation(fields: [issuedById], references: [id], onDelete: Restrict)

  // Layer 4
  photos WorkPhoto[]
  proof  WorkProof?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([issuedById, completedAt])
  @@map("work_orders")
}

// ===========================================================================
// LAYER 2 — escalation. Ours, not NYC's.
// ===========================================================================
//
// NYC 311 records no escalation: a request sits with its agency until the agency
// closes it. Layer 2 adds a ladder within each agency — the accountable officer,
// then the agency's supervisor, then the borough commissioner — and a sweep that
// climbs it when a request passes its derived deadline.
//
// The sweep acts only on live requests: those filed through this system, and
// imported ones this system has since acted on. The 350,000 untouched imported
// rows are NYC's history, every open one is already past its deadline at the
// snapshot, and escalating them would be reacting today to delays that happened
// years ago (I6).

/// What set an escalation off.
enum EscalationTrigger {
  SLA_BREACH /// the sweep found the request past its deadline, or past twice its service level
  MANUAL /// a person raised it with a reason, possibly before any breach
}

/// One rung climbed, kept rather than overwritten.
///
/// `ServiceRequest.escalationLevel` answers "how high is it now"; this answers
/// how it got there, when, why, and who it reached. The unique pair is what makes
/// the sweep safe to run twice at once: a rung can be reached exactly once, and a
/// second writer is refused by the database rather than trusted to check first.
///
/// Escalation does not move ownership. The officer still answers for the request;
/// escalating pulls someone more senior in beside them.
model Escalation {
  id         Int               @id @default(autoincrement())
  requestId  Int
  fromLevel  Int
  toLevel    Int
  trigger    EscalationTrigger
  reason     String
  /// Null when the sweep raised it rather than a person.
  raisedById Int?
  /// The senior person it reached. Null only if nobody holds that rung in the
  /// agency — which is itself worth seeing, so the escalation is still recorded.
  toUserId   Int?
  /// Real time: an escalation is an event in this system.
  at         DateTime

  /// When the senior person at this rung said they had it, and what they said.
  /// An escalation nobody acknowledges is indistinguishable from one nobody
  /// read, and that difference is the whole of what the ladder is for.
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  acknowledgeNote  String?
  /// When the request closed, ending what this rung was raised about. Cleared
  /// again if the request is reopened.
  resolvedAt       DateTime?

  request        ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  raisedBy       User?          @relation("EscalationBy", fields: [raisedById], references: [id], onDelete: Restrict)
  toUser         User?          @relation("EscalationTo", fields: [toUserId], references: [id], onDelete: Restrict)
  acknowledgedBy User?          @relation("EscalationAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([requestId, toLevel])
  @@index([toUserId, at])
  @@index([at])
  @@map("escalations")
}

// ===========================================================================
// LAYER 3 — GRIE, the risk radar. Ours, not NYC's.
// ===========================================================================
//
// One score per (model, agency, community board, month). The model is data
// exported by research/drishti_research/nyc_grie.py; this table records what it
// said and, once the next month is on record, what then happened — so "do
// high-scored boards actually fail next month?" can be asked of the rows
// themselves rather than of a claim.
//
// GCCE has no table. Routing was measured and found to have nothing to learn in
// this slice (F-23); the report is read from backend/data/gcce-spec.json.

model RiskScore {
  id          Int      @id @default(autoincrement())
  agencyId    Int
  orgUnitId   Int
  /// First instant of the calendar month scored, in record time.
  month       DateTime
  requests    Int
  /// The five raw signals, as services/riskSignals.ts computed them.
  signals     Json
  /// [{ factor, label, raw, normalised, weight, contribution, explanation }]
  factors     Json
  /// The weighted sum on 0-100. It ranks; it is not a probability, and the
  /// product never shows it as one.
  score       Float
  /// Calibrated: the chance this unit's missed-deadline rate lands in the worst
  /// fifth of the panel next month.
  probability Float
  needsReview Boolean
  /// Next month's missed-deadline rate, when that month is on record with
  /// enough requests to count. Null for the last month of the corpus.
  nextBreachRate Float?
  /// Whether it landed in the worst fifth. Null when not yet observable.
  outcome     Boolean?
  modelVersion String
  computedAt  DateTime @default(now())

  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: Restrict)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)

  @@unique([modelVersion, agencyId, orgUnitId, month])
  @@index([month, agencyId, probability])
  @@map("risk_scores")
}

// ===========================================================================
// LAYER 4 — photo verification. Ours, not NYC's.
// ===========================================================================
//
// NYC 311 closes a request with a sentence of agency text and nothing else: no
// photograph, no evidence, nothing a resident could check. Layer 4 asks the
// crew for a picture and then asks what that picture can honestly prove.
//
// Not much, on its own. No check here can tell that a pothole is filled. What
// they can tell is that a submission is not what it claims: nothing attached, a
// photograph already sent against another job, one taken before the job
// existed, one taken somewhere else. So the machine screens out bad faith and
// then asks the person who can see the street — the resident who reported it —
// and an officer only when that answer is missing or disputed.

/// Where a submission stands.
enum ProofOutcome {
  /// Not proof: nothing attached, or a photograph already used elsewhere.
  REJECTED
  /// Plausible. The person who reported it has been asked.
  NEEDS_CITIZEN
  /// A person has to look: the resident disputed it, or the proof was weak and
  /// nobody vouched for it.
  NEEDS_OFFICER
  /// Accepted — by the resident, by the officer, or by strong proof that nobody
  /// disputed within the grace period.
  CONFIRMED
}

/// One photograph sent back from a job.
model WorkPhoto {
  id          Int       @id @default(autoincrement())
  workOrderId Int
  /// The name on disk, always generated here — never the one the uploader chose.
  storedName  String    @unique
  mimeType    String
  bytes       Int
  /// Exact identity: catches the same file sent twice.
  sha256      String
  /// A 64-bit difference hash, hex. Catches the same photograph re-encoded,
  /// resized or lightly cropped — the ways an exact hash is defeated. Null when
  /// the file could not be decoded, which makes that check inconclusive rather
  /// than failed.
  dHash       String?
  width       Int?
  height      Int?
  /// From EXIF, where the phone left it. Most strip it, so null is ordinary.
  capturedAt  DateTime?
  exifLat     Float?
  exifLng     Float?
  uploadedAt  DateTime  @default(now())
  /// When the file was deleted under the retention rule for refused submissions.
  /// The row stays, hashes and all: removing the picture must not let the same
  /// picture be sent again as new.
  purgedAt    DateTime?

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([sha256])
  @@map("work_photos")
}

/// What the checks made of a job's photographs, and who decided in the end.
model WorkProof {
  id          Int          @id @default(autoincrement())
  workOrderId Int          @unique
  /// 0-100 across the checks below. It weighs evidence of bad faith; it is not
  /// a probability that the work was done, and nothing presents it as one.
  score       Float
  /// [{ check, label, passed, weight, contribution, detail }] — the working,
  /// kept so a crew can be told exactly what failed.
  checks      Json
  outcome     ProofOutcome

  /// The reporting resident's answer, when there is one to ask. It outranks
  /// every automated check in both directions.
  citizenVerdict Boolean?
  citizenAt      DateTime?

  /// The officer's decision, when it came to that.
  decidedById  Int?
  decidedAt    DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("ProofOfficer", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([outcome, updatedAt])
  @@map("work_proofs")
}

