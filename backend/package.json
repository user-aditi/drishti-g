{
  "name": "drishti-g-api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../.env -- tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "export:model": "tsx scripts/export-model-spec.ts",
    "backfill:community": "dotenv -e ../.env -- tsx scripts/backfill-community.ts",
    "migrate:crew": "dotenv -e ../.env -- tsx scripts/workers-to-crew.ts",
    "org:build": "dotenv -e ../.env -- tsx scripts/build-org-tree.ts",
    "org:roles": "dotenv -e ../.env -- tsx scripts/backfill-roles.ts",
    "demo:rebalance": "dotenv -e ../.env -- tsx scripts/rebalance-demo.ts",
    "crew:anonymise": "dotenv -e ../.env -- tsx scripts/anonymise-retired-crew.ts",
    "test:db": "docker exec drishti_postgres psql -U drishti -d postgres -c \"DROP DATABASE IF EXISTS drishti_g_test;\" -c \"CREATE DATABASE drishti_g_test OWNER drishti;\"",
    "test:setup": "npm run test:db && dotenv -v DATABASE_URL=postgresql://drishti:drishti_dev_password@localhost:5432/drishti_g_test -- prisma db push --skip-generate --accept-data-loss",
    "sim:run": "dotenv -e ../.env -v SIM_TIME_TRAVEL=1 -- tsx scripts/simulate-traffic.ts",
    "dev:sim": "dotenv -e ../.env -v SIM_RELAX_RATE_LIMIT=1 -- tsx watch src/index.ts",
    "dev:before": "dotenv -e ../.env -v DATABASE_URL=postgresql://drishti:drishti_dev_password@localhost:5432/drishti_g_before -- tsx watch src/index.ts",
    "sim:repair-deadlines": "dotenv -e ../.env -v SIM_TIME_TRAVEL=1 -- tsx scripts/repair-sim-deadlines.ts",
    "export:training": "dotenv -e ../.env -- tsx scripts/export-training-data.ts",
    "export:eventlog": "dotenv -e ../.env -- tsx scripts/export-event-log.ts",
    "export:resolutions": "dotenv -e ../.env -- tsx scripts/export-resolutions.ts",
    "accept": "dotenv -e ../.env -- tsx scripts/acceptance.ts",
    "setup": "npm run prisma:deploy && npm run seed && npm run org:build && npm run migrate:crew && npm run org:roles"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
