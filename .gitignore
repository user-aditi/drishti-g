# Research datasets (downloaded, not vendored)
research/data/bpic2015/
__pycache__/

# Training inputs are regenerated, never edited. The exported model specs and
# their parity fixtures ARE committed: they are the shipped model, and a clean
# clone without them starts fine and silently reverts to pre-Wave-3 behaviour —
# deadlines back to the seeded guesses, the gate inert, three warnings nobody
# reads. See backend/src/services/modelSpec.ts.
research/data/complaints.csv
research/data/sim-labels.csv
research/data/event-log.csv
research/data/resolutions.csv
research/data/bpic2018/

# The NYC 311 corpus is 150MB of downloaded public data, re-pullable with
# `python -m drishti_research.nyc_pull`. Its manifest and the derived SLA table
# ARE committed: they are what makes a re-pull checkable — the manifest records
# the vintage and filter, and the SLA table is a declared constant the backend
# imports against.
research/data/nyc/brooklyn.csv
research/data/nyc/parts/
# The routing arm's slice, the four complaint types more than one agency works:
# 25MB, re-pullable with `python -m drishti_research.nyc_routing --refresh`.
research/data/nyc/routing.csv
research/data/nyc/routing-parts/

# The QR4Change photographs (CC BY 4.0): a 1,000-image sample, ~1.9GB, fetched
# with `python -m drishti_research.qr4change`. The manifest and the measurements
# are committed; the photographs are not.
research/data/qr4change/*
!research/data/qr4change/manifest.json

# End-to-end test artefacts. The session files are signed tokens and must never be
# committed; the photographs are regenerated on every run.
frontend/e2e/.auth/
frontend/e2e/.tmp/
frontend/test-results/
frontend/playwright-report/
