# ---- Postgres ----
POSTGRES_USER=drishti
POSTGRES_PASSWORD=drishti_dev_password
POSTGRES_DB=drishti_g
# Host-side URL. Inside Docker this is overridden to point at the postgres service.
DATABASE_URL=postgresql://drishti:drishti_dev_password@localhost:5432/drishti_g

# ---- Auth ----
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_dev_only_do_not_use_in_production
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=14d

# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=uploads
PUBLIC_URL=http://localhost:4000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

# Where the browser app lives. Work-order QR codes point here.
APP_URL=http://localhost:3000

# --- Traffic simulation only (backend/scripts/simulate-traffic.ts) ----------
# Both are refused when NODE_ENV=production. Neither belongs in a real .env.
#
# SIM_TIME_TRAVEL=1        lets the simulator rewrite timestamps after the API
#                          has written them, so a run spreads over months
#                          instead of an afternoon. Set by `npm run sim:run`.
# SIM_RELAX_RATE_LIMIT=1   turns off the per-IP limit on the public crew
#                          surface. Every simulated crew member shares one
#                          address, so the limiter would otherwise refuse most
#                          submissions. Set by `npm run dev:sim`.
