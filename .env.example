# ---- Postgres ----
POSTGRES_USER=drishti
POSTGRES_PASSWORD=drishti_dev_password
POSTGRES_DB=drishti_g
# Host-side URL. Inside Docker this is overridden to point at the postgres service.
DATABASE_URL=postgresql://drishti:drishti_dev_password@localhost:5432/drishti_g

# ---- Auth ----
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_dev_only_do_not_use_in_production
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=14d

# ---- The system clock ----
# Where this system stands in time. Everything that asks "is this overdue?"
# compares against this date, and never against Date.now().
#
# The corpus is a snapshot: requests filed 2022-2025, with statuses and closure
# times as NYC published them when the data was pulled. Evaluated against the
# wall clock, every queue, age and breach figure describes a day the record does
# not. The alternative - shifting the imported dates forward so they look
# recent - would hide that and destroy the seasonality the risk signals are
# built on (garbage complaints spike in summer, streetlights in winter). So the
# dates stay real and the observer moves.
#
# Defaults to the snapshot date, pulled_at in research/data/nyc/brooklyn.meta.json:
# the one moment at which every field of every row is true at once. Not the last
# created_date - NYC closed 6,628 of these requests after it, and standing there
# showed them as Closed on a day they were open. `npm run verify:import` fails if
# the default and the manifest drift apart after a re-pull.
SYSTEM_REFERENCE_DATE=2026-09-09T22:34:59.000Z

# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where photographs sent back from a job are written (Layer 4).
UPLOAD_DIR=uploads
# How long the resident who reported it has to answer before the system decides
# without them, and how often it looks for submissions that ran out of time.
CITIZEN_GRACE_HOURS=48
PROOF_SWEEP_MS=600000
PUBLIC_URL=http://localhost:4000

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://localhost:4000/api/v1

# Where the browser app lives. Work-order QR codes point here.
APP_URL=http://localhost:3000
